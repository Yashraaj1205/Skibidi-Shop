# Database Config
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=apt_orders
DB_USER=apt_user
DB_PASSWORD=apt_pass

# Firebase Admin SDK Configuration
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-key.json

# Comma-separated emails granted admin access to /api/orders and the admin dashboard
ADMIN_EMAILS=owner@example.com

# Comma-separated browser origins allowed to call the API (empty = allow all, dev only)
CORS_ORIGINS=http://localhost:3000

# Nodemailer SMTP Email Config (Google App Password)
SMTP_USER=your_dummy_email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# Firebase Web Config (Client Side configuration injected dynamically)
FIREBASE_API_KEY=AIzaSyBmNkXx4iBGAuI...
FIREBASE_AUTH_DOMAIN=realtime-orders-12.firebaseapp.com
FIREBASE_PROJECT_ID=realtime-orders-12
FIREBASE_STORAGE_BUCKET=realtime-orders-12.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=524467064012
FIREBASE_APP_ID=1:524467064012:web:b28e1c67fbaf8b18b88669
